{"create-hana-table":{"prefix":"createhanatable","body":["CREATE COLUMN TABLE \"${1:TableName}\" (","    \"${2:Id}\" INTEGER NOT NULL,","    \"DocEntry\" INTEGER NOT NULL,","    \"DocNum\" INTEGER NOT NULL,","    \"${3:CreatedDate}\" TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,","    \"${4:UpdatedDate}\" TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,","    CONSTRAINT \"PK_${1:TableName}\" PRIMARY KEY (\"${2:Id}\"),","    CONSTRAINT \"FK_${1:TableName}_${5:TableName}\" FOREIGN KEY (\"${2:Id}\") REFERENCES ${5:TableName} (\"${6:Id}\")",");"]}}